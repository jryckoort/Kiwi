# Copy to .env and fill in real values before running docker compose.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,kiwi.example.com

# Used by the app to build DATABASE_URL below and by entrypoint.sh to wait for Postgres.
POSTGRES_DB=kiwi
POSTGRES_USER=kiwi
POSTGRES_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgres://kiwi:change-me@db:5432/kiwi

CELERY_BROKER_URL=redis://redis:6379/0

# Domain Caddy will request a certificate for. Use "localhost" for local testing.
SITE_DOMAIN=localhost
