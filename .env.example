# Copy to .env and fill in real values before running docker compose.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,kiwi.example.com

# Used by the app to build DATABASE_URL below and by entrypoint.sh to wait for Postgres.
POSTGRES_DB=kiwi
POSTGRES_USER=kiwi
POSTGRES_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgres://kiwi:change-me@db:5432/kiwi

CELERY_BROKER_URL=redis://redis:6379/0

# Domain Caddy will request a certificate for. Use "localhost" for local testing.
SITE_DOMAIN=localhost

# Email — used to send magic login links. Works with any standard SMTP
# provider. Leave EMAIL_HOST empty to keep printing emails to the container
# logs instead of actually sending them.
# Example for Gmail SMTP: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=you@gmail.com, EMAIL_HOST_PASSWORD=<app password>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Kiwi <noreply@example.com>
